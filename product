<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Information - M/S PATHAN MOTORS</title>
  <!-- Puter.js SDK -->
  <script src="https://js.puter.com/v2/"></script>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background-color: #f0f2f5;
      margin: 0;
      padding: 0;
      color: #333;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    .main-wrapper {
      flex: 1;
      padding: 25px 15px;
    }
    .container {
      max-width: 950px;
      margin: 0 auto;
      background: #ffffff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }
    /* হেডার ডিজাইন */
    .header-section {
      display: flex;
      align-items: center;
      gap: 20px;
      border-bottom: 2px solid #eaedf3;
      padding-bottom: 20px;
      margin-bottom: 25px;
    }
    .header-logo {
      height: 75px;
      width: auto;
      object-fit: contain;
    }
    .header-title-box h1 {
      margin: 0;
      color: #d90429;
      font-size: 24px;
      letter-spacing: 0.5px;
    }
    .header-title-box h3 {
      margin: 4px 0 0;
      color: #2b2d42;
      font-size: 16px;
      font-weight: 600;
    }
    /* অথেন্টিকেশন বক্স */
    .auth-box {
      background: #fdf2f2;
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid #fecaca;
    }
    .upload-zone {
      border: 2px dashed #d90429;
      border-radius: 8px;
      padding: 25px;
      text-align: center;
      background: #fffafa;
      cursor: pointer;
      margin-bottom: 20px;
      transition: all 0.2s;
    }
    .upload-zone:hover {
      background: #fff1f1;
    }
    .upload-zone input { display: none; }
    .preview-box img {
      max-width: 180px;
      max-height: 180px;
      border-radius: 6px;
      margin-top: 10px;
      border: 1px solid #ddd;
    }
    .btn {
      padding: 10px 20px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-auth { background: #d90429; color: #fff; }
    .btn-process { background: #1a73e8; color: #fff; }
    .btn-copy { background: #0f9d58; color: #fff; display: none; }
    .btn:disabled { background: #aaa; cursor: not-allowed; }
    #status {
      margin: 15px 0;
      font-weight: bold;
      font-size: 14px;
    }
    .loading { color: #d97706; }
    .success { color: #0f9d58; }
    .error { color: #d93025; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      border: 1px solid #e0e0e0;
      padding: 12px;
      text-align: left;
      font-size: 14px;
    }
    th { background-color: #f8fafc; color: #475569; }
    tr:nth-child(even) { background-color: #f9fbfd; }
    /* ফুটার ডিজাইন */
    footer {
      background: #1e293b;
      color: #f8fafc;
      padding: 15px 20px;
      text-align: center;
      font-size: 13px;
      margin-top: auto;
    }
    footer a {
      color: #60a5fa;
      text-decoration: none;
    }
    footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

<div class="main-wrapper">
  <div class="container">
    <!-- হেডার অংশ -->
    <div class="header-section">
      <img src="data:image/png;base64," alt="Pathan Motors Logo" class="header-logo">
      <div class="header-title-box">
        <h1>M/S PATHAN MOTORS</h1>
        <h3>Product Information System</h3>
      </div>
    </div>

    <!-- অথেন্টিকেশন বক্স (লগইন) -->
    <div class="auth-box">
      <div id="userInfo">লগইন স্ট্যাটাস চেক করা হচ্ছে...</div>
      <button id="authBtn" class="btn btn-auth" onclick="handleAuth()">গুগল দিয়ে সাইন ইন করুন</button>
    </div>

    <!-- ইমেজ আপলোড অংশ -->
    <div class="upload-zone" onclick="document.getElementById('fileInput').click()">
      <input type="file" id="fileInput" accept="image/*" onchange="handleImage(event)">
      <strong>ছবি সিলেক্ট করুন বা এখানে ড্রপ করুন</strong>
      <p style="margin: 5px 0 0; color: #777; font-size: 13px;">হাতের লেখা ইনভয়েস বা খাতার স্পষ্ট ছবি দিন</p>
      <div class="preview-box" id="previewBox"></div>
    </div>

    <!-- অ্যাকশন বাটন -->
    <div style="display: flex; gap: 10px;">
      <button id="processBtn" class="btn btn-process" onclick="processImage()" disabled>⚡ Auto Extract Data</button>
      <button id="copyBtn" class="btn btn-copy" onclick="copyForSheet()">📋 Copy for Google Sheets</button>
    </div>

    <div id="status"></div>

    <!-- এক্সট্রাক্ট করা ডেটা টেবিল -->
    <table id="resultTable" style="display:none;">
      <thead>
        <tr>
          <th style="width: 25%;">GROUP</th>
          <th>DESCRIPTION</th>
        </tr>
      </thead>
      <tbody id="tableBody"></tbody>
    </table>
  </div>
</div>

<!-- ফুটার অংশ (ক্রেডিট) -->
<footer>
  Developed by <b>Dip Raha</b> | Email: <a href="mailto:dipraha7@gmail.com">dipraha7@gmail.com</a> | Cell: <a href="tel:01910226680">01910226680</a>
</footer>

<script>
  let selectedFile = null;
  let extractedRows = [];

  window.onload = async function() {
    checkUser();
  };

  async function checkUser() {
    if (puter.auth.isSignedIn()) {
      const user = await puter.auth.getUser();
      document.getElementById('userInfo').innerHTML = `স্বাগতম, <b>${user.username || 'User'}</b>`;
      document.getElementById('authBtn').innerText = 'লগআউট';
    } else {
      document.getElementById('userInfo').innerText = 'যেকোনো Gmail দিয়ে সাইন ইন করুন';
      document.getElementById('authBtn').innerText = 'গুগল দিয়ে সাইন ইন করুন';
    }
  }

  async function handleAuth() {
    if (puter.auth.isSignedIn()) {
      puter.auth.signOut();
      checkUser();
    } else {
      await puter.auth.signIn();
      checkUser();
    }
  }

  function handleImage(event) {
    const file = event.target.files[0];
    if (!file) return;

    selectedFile = file;
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('previewBox').innerHTML = `<img src="${e.target.result}" alt="Preview">`;
      document.getElementById('processBtn').disabled = false;
      document.getElementById('status').innerText = '';
    };
    reader.readAsDataURL(file);
  }

  async function processImage() {
    if (!puter.auth.isSignedIn()) {
      alert("অনুগ্রহ করে আগে গুগল দিয়ে সাইন ইন করুন!");
      await puter.auth.signIn();
      checkUser();
      return;
    }

    if (!selectedFile) {
      alert("অনুগ্রহ করে একটি ছবি সিলেক্ট করুন!");
      return;
    }

    const status = document.getElementById('status');
    const processBtn = document.getElementById('processBtn');
    status.className = 'loading';
    status.innerText = 'স্বয়ংক্রিয়ভাবে হাতের লেখা পড়ে ডেটা প্রসেস হচ্ছে, অনুগ্রহ করে অপেক্ষা করুন...';
    processBtn.disabled = true;

    const promptText = `
You are an expert handwritten auto-parts invoice parser.
Read the table in the image row by row. If there are ditto marks (' ' or -) repeating previous rows, fill in the correct values.
Strict formatting instructions:
Format each row as a raw JSON array of objects:
[
  {
    "group": "Gear/Spring/etc.",
    "formatted_description": "Brand name - Description (local language) - car details"
  }
]
Rule for "formatted_description":
- Format MUST be: Brand - Description (Local Language) - Car Details
- If Local Language is present, wrap it in brackets: (Local Language).
- If Local Language is NOT present (empty or dash), DO NOT include brackets. The format will be: Brand - Description - Car Details.
Return ONLY valid raw JSON without markdown or backticks.
`;

    try {
      const response = await puter.ai.chat(promptText, selectedFile, {
        model: 'gemini-2.5-flash'
      });

      let rawText = response.toString().trim();
      if (rawText.startsWith('```')) {
        rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();
      }

      extractedRows = JSON.parse(rawText);
      renderTable(extractedRows);

      status.className = 'success';
      status.innerText = `সফলভাবে ${extractedRows.length} টি আইটেম তৈরি হয়েছে!`;
      document.getElementById('copyBtn').style.display = 'inline-flex';
    } catch (err) {
      console.error(err);
      status.className = 'error';
      status.innerText = 'সমস্যা হয়েছে: ' + err.message;
    } finally {
      processBtn.disabled = false;
    }
  }

  function renderTable(rows) {
    const table = document.getElementById('resultTable');
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '';

    rows.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${r.group || ''}</td><td>${r.formatted_description || ''}</td>`;
      tbody.appendChild(tr);
    });

    table.style.display = 'table';
  }

  // শুধুমাত্র ডেটা কপি করার জন্য আপডেট করা ফাংশন (কোনো হেডার থাকবে না)
  function copyForSheet() {
    if (extractedRows.length === 0) return;

    let tsv = "";
    extractedRows.forEach(r => {
      tsv += `${r.group || ''}\t${r.formatted_description || ''}\n`;
    });

    navigator.clipboard.writeText(tsv).then(() => {
      const copyBtn = document.getElementById('copyBtn');
      const originalText = copyBtn.innerHTML;
      copyBtn.innerHTML = '✅ Copied Data Only!';
      setTimeout(() => { copyBtn.innerHTML = originalText; }, 2000);
    });
  }
</script>

</body>
</html>
